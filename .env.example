# Copy to .env for local development. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Behind TLS in production this stays 1. Local http development: set 0.
DJANGO_SECURE_SSL_REDIRECT=0
DATABASE_URL=postgres://jiranichama:jiranichama@localhost:5440/jiranichama
REDIS_URL=redis://localhost:6390/0

# Field encryption (Fernet keys, newest first). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEYS=
# Keyed hashes for phone and ID lookups. Long random string, never rotated casually.
HMAC_KEY=

# Platform signing: "local" (PEM key below, dev only) or "kms" (AWS KMS key id).
PLATFORM_SIGNER=local
PLATFORM_SIGNING_KEY_PEM=
KMS_KEY_ID=
AWS_REGION=

# SMS: comma-separated backends, tried in order.
SMS_BACKENDS=apps.notify.sms.ConsoleBackend
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
AFRICASTALKING_SANDBOX=1
