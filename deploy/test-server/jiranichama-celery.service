[Unit]
Description=JiraniChama background jobs (test server)
After=network.target postgresql.service redis-server.service

[Service]
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/sites/jiranichama
EnvironmentFile=/home/deploy/sites/jiranichama.env
ExecStart=/home/deploy/sites/jiranichama/.venv/bin/celery -A config worker --concurrency 1 --loglevel INFO -Q celery,feeds,rules,notify,documents,signing
Restart=always
RestartSec=5
MemoryMax=600M

[Install]
WantedBy=multi-user.target
