      "fines_to_reverse": []
    },
    {
      "name": "last day of grace is still on time",
      "amount_cents": 100000, "value_date": "2026-03-07",
      "dues": [["2026-03", 100000]], "fines": [],
      "slices": [{"kind": "contribution", "amount_cents": 100000, "period": "2026-03", "outcome": "on_time", "fine_id": null}],
      "fines_to_reverse": []
    },
    {
      "name": "the day after grace is late",
      "amount_cents": 100000, "value_date": "2026-03-08",
      "dues": [["2026-03", 100000]], "fines": [],
      "slices": [{"kind": "contribution", "amount_cents": 100000, "period": "2026-03", "outcome": "late", "fine_id": null}],
      "fines_to_reverse": []
    },
