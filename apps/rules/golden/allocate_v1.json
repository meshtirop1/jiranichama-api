        {"kind": "contribution", "amount_cents": 100000, "period": "2026-04", "outcome": "on_time", "fine_id": null}
      ],
      "fines_to_reverse": []
    },
    {
      "name": "partial payment stops where the money runs out",
      "amount_cents": 150000, "value_date": "2026-04-06",
